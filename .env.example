DATABASE_URL=
# Legacy: no longer used to sign tokens (see AUTH_ACCESS_TOKEN_SECRET).
JWT_SECRET=
NODE_ENV=development

NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_AWS_REGION=
NEXT_PUBLIC_AWS_ACCESS_KEY_ID=
NEXT_PUBLIC_AWS_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_ROOT_PATH=
NEXT_PUBLIC_TAX_RATE=0
NEXT_PUBLIC_PAY_PERIOD_START="2025-01-01"
NEXT_PUBLIC_BASE_ZONE=

MAILERSEND_API_TOKEN=
MAILERSEND_EMAIL_API_URL=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=
RESET_EMAIL_RESEND_COOLDOWN_MINUTES=5

# Admin session. Required: at least 32 characters, different from JWT_SECRET.
# Generate locally, e.g. `openssl rand -base64 48`. Never commit it.
AUTH_ACCESS_TOKEN_SECRET=
# Lifetimes in seconds. Keep ACCESS_TTL < RENEW_BEFORE < REFRESH_TTL.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_TOKEN_RENEW_BEFORE_SECONDS=604800
AUTH_REFRESH_TOKEN_REUSE_GRACE_SECONDS=60
# auto | true | false. auto = Secure when the request (or X-Forwarded-Proto) is https.
AUTH_COOKIE_SECURE=auto
